# Copy to .env and fill in real values. Never commit the real .env file.

PORT=4000
CORS_ORIGIN=http://localhost:8080
DB_PATH=./data/obit.db

# Long random string — used to sign portal session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=replace-me-with-a-long-random-string

MEMBERSHIP_FEE_NGN=2000

# --- Payment providers --------------------------------------------------
# Leave BOTH blank to stay in sandbox: /api/payments/membership/initialize
# will return a placeholder checkout pointer, and real webhook signature
# checks will simply fail closed (reject) rather than trust anything.
PAYSTACK_SECRET_KEY=
# Keep false until Paystack status is Pre-approved/Approved and live key is installed.
PAYSTACK_LIVE_ENABLED=false
MONNIFY_SECRET_KEY=

# --- Local webhook testing only ------------------------------------------
# Set WEBHOOK_SANDBOX_MODE=true ONLY on your own machine to test the payment
# webhook end-to-end with scripts/simulate-webhook.js, using a shared secret
# instead of a real provider signature. NEVER enable this in a deployed
# environment — it exists purely so a developer can exercise the full
# ACQUIRE -> VERIFY -> ACTIVATE -> COLLECT flow before real provider keys
# are available.
WEBHOOK_SANDBOX_MODE=false
WEBHOOK_SANDBOX_SECRET=dev-only-shared-secret


# --- Youverify identity verification (sole provider) ---------------------
# Keep sandbox until written provider approval, sandbox acceptance and budget approval.
# Never expose YOUVERIFY_SECRET_KEY in frontend code or commit a real key.
YOUVERIFY_ENV=sandbox
YOUVERIFY_SECRET_KEY=
YOUVERIFY_PRODUCTION_AUTHORIZED=false
YOUVERIFY_APPROVED_PRODUCTS=
YOUVERIFY_DAILY_REQUEST_LIMIT=
YOUVERIFY_DAILY_BUDGET_KOBO=
# Maximum agreed cost per dispatched request, including taxes and fees.
YOUVERIFY_BVN_MAX_COST_KOBO=
YOUVERIFY_NIN_MAX_COST_KOBO=

# Membership transfer uses the approved MARKET_TRANSFER_* receiving account.
# Set false to pause new membership transfer instructions. Existing references
# retain their original account and fee for reconciliation.
MEMBERSHIP_TRANSFER_ENABLED=true

# Development-only KYC/payment simulation routes. Keep false on Render.
ENABLE_DEV_ROUTES=false

# Internal transfer checkout. Enable only after the receiving account is confirmed.
MARKET_TRANSFER_ENABLED=false
MARKET_TRANSFER_BANK_NAME=
MARKET_TRANSFER_ACCOUNT_NAME=
MARKET_TRANSFER_ACCOUNT_NUMBER=

# Marketplace Monnify sandbox. Use a separate staging service and database.
# These are separate from the membership MONNIFY_SECRET_KEY above.
# Live collection is not enabled by this configuration.
MARKET_CHECKOUT_MODE=off
MARKET_MONNIFY_API_KEY=
MARKET_MONNIFY_SECRET_KEY=
MARKET_MONNIFY_CONTRACT_CODE=
MARKET_MONNIFY_CALLBACK_URL=
MARKET_MONNIFY_ALLOW_UNSIGNED_SANDBOX_WEBHOOK=false
