# Copy to .env and fill in real values. Never commit the real .env file.

PORT=4000
CORS_ORIGIN=http://localhost:8080
DB_PATH=./data/obit.db

# Long random string — used to sign portal session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=replace-me-with-a-long-random-string

MEMBERSHIP_FEE_NGN=2000

# --- Payment providers --------------------------------------------------
# Leave BOTH blank to stay in sandbox: /api/payments/membership/initialize
# will return a placeholder checkout pointer, and real webhook signature
# checks will simply fail closed (reject) rather than trust anything.
PAYSTACK_SECRET_KEY=
# Keep false until Paystack status is Pre-approved/Approved and live key is installed.
PAYSTACK_LIVE_ENABLED=false
MONNIFY_SECRET_KEY=

# --- Local webhook testing only ------------------------------------------
# Set WEBHOOK_SANDBOX_MODE=true ONLY on your own machine to test the payment
# webhook end-to-end with scripts/simulate-webhook.js, using a shared secret
# instead of a real provider signature. NEVER enable this in a deployed
# environment — it exists purely so a developer can exercise the full
# ACQUIRE -> VERIFY -> ACTIVATE -> COLLECT flow before real provider keys
# are available.
WEBHOOK_SANDBOX_MODE=false
WEBHOOK_SANDBOX_SECRET=dev-only-shared-secret


# --- Dojah identity verification ----------------------------------------
# Keep sandbox until Obit Cooperative has completed Dojah business approval.
# Never expose DOJAH_SECRET_KEY in frontend code or commit a real key.
DOJAH_ENV=sandbox
DOJAH_APP_ID=
DOJAH_SECRET_KEY=

# Development-only KYC/payment simulation routes. Keep false on Render.
ENABLE_DEV_ROUTES=false
